{
  "name": "dishsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "wasm": "cd ../core && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/dishsim_core.wasm ../web/public/dishsim.wasm",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "experiment": "esbuild scripts/experiment.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/experiment.mjs && node node_modules/.cache/experiment.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
